# Copy to .env for local development. Never commit a real .env file.
# The backend reads these from the environment; .env is only a convenience.

ENVIRONMENT=development

# SQLite by default for local dev. For the Azure Functions deployment use a
# Postgres URL, e.g. postgresql+psycopg://user:password@host:5432/claims
DATABASE_URL=sqlite:///./claims.db

# Local file storage. Ignored when STORAGE_BACKEND=azure_blob.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# mock | recorded | azure_openai | gemini | anthropic | openai.
# Mock and recorded need no keys. Recorded replays the saved Claude
# eval outputs for dataset files and fails on anything else.
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# A claim stuck in "processing" longer than this is treated as a dead job and
# may be re-triggered.
EXTRACTION_STALE_AFTER_SECONDS=600

# Azure OpenAI. The deployment name conventionally matches the model name;
# gpt-6.1-sol is the current general-purpose model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
AZURE_OPENAI_API_VERSION=2024-10-21
# Strict JSON Schema mode (Azure only, default off). The live run sets
# this to true for the strict trial and back to false on rejection.
AZURE_OPENAI_STRICT_JSON_SCHEMA=false

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-8-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Standard OpenAI API (used if Azure setup is unavailable). Same model as Azure.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# local | azure_blob. Azure Functions must use azure_blob (no local disk).
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=claim-uploads

# Max files per claim, and CORS origins (comma-separated) for the dev frontend.
MAX_FILES_PER_CLAIM=10
CORS_ORIGINS=http://localhost:5173

# Optional override for the policies file; defaults to the packaged sample policies.
# POLICIES_PATH=policies/custom.yaml
